# 실제 키를 여기 넣지 마세요. 이 파일은 저장소에 추적되는 **빈 양식**입니다.
# 값을 채운 사본은 .env로 저장하고, .env는 .gitignore가 막습니다.
#
# 이름은 GitHub Actions Secret 이름과 **정확히 같아야** 합니다 — 로컬과 CI가
# 같은 코드로 돌아가려면 코드가 읽는 이름 하나만 있어야 합니다.
#
#   로컬:  node --env-file=.env scripts/build-quotes.mjs
#   CI:    워크플로의 env: 블록이 secrets를 같은 이름으로 넣어 줍니다.

# ── 배치: 없으면 실패 ────────────────────────────────────────────────────────

# 공공데이터포털. 금융위원회_주식시세정보(15094808)·증권상품시세정보(15094806)
# ·일반상품시세정보(15094805)·KRX상장종목정보(15094775) 활용신청이 각각 필요합니다.
# 쓰는 곳: scripts/build-quotes.mjs · scripts/build-tickers.mjs
# 발급: https://www.data.go.kr
DATA_GO_KR_KEY=

# 한국수출입은행 Open API. 환율.
# 쓰는 곳: scripts/build-quotes.mjs
# 발급: https://www.koreaexim.go.kr/ir/HPHKIR020M01
KOREAEXIM_AUTH_KEY=

# 한국은행 ECOS. **daily-rates.yml에서는 필수입니다** — 없으면 국내 금리 계열이
# 통째로 빠진 채 배치가 "성공"으로 끝납니다(부분 실패를 허용하는 구조).
# 쓰는 곳: scripts/build-daily-rates.mjs(필수) · scripts/build-quotes.mjs(은 시세, 선택)
# 발급: https://ecos.bok.or.kr/api
ECOS_AUTH_KEY=

# ── 배치: 없으면 해당 부분만 건너뜀 ─────────────────────────────────────────

# OPEN DART. 국내 종목의 업종코드. 없으면 업종 없이 진행합니다.
# 쓰는 곳: scripts/build-tickers.mjs
# 발급: https://opendart.fss.or.kr
DART_API_KEY=

# CoinGecko. 가상자산 원화 시세.
# 쓰는 곳: scripts/build-quotes.mjs
# 발급: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# demo | pro — 유료 전환 시 pro. 키가 아니라 요금제 구분입니다.
# 기본값 demo (코드가 자체 기본값을 가짐)
COINGECKO_PLAN=

# ECOS 은 시세의 통계표코드. **키가 아니라 코드값**입니다. 키 발급 후
# StatisticItemList(통계코드검색)에서 "귀금속"·"은"으로 찾아 확정해야 합니다.
# 미설정이면 은 시세를 건너뜁니다.
ECOS_SILVER_STAT_CODE=

# ── 모델(파이썬, model/) ────────────────────────────────────────────────────

# FRED / ALFRED. 경기국면 모델의 시계열 수집.
# 쓰는 곳: model/src/business_cycle/data/alfred.py
# 발급: https://fredaccount.stlouisfed.org/apikeys
# (model/.env.example에도 같은 항목이 있습니다 — 이름이 같아야 합니다)
FRED_API_KEY=

# ── RLS 격리 시험 (로컬 전용, 워크플로 없음) ────────────────────────────────
#
# 주의: 앱이 쓰는 Supabase URL·anon key는 lib/supabase-config.js에 **평문으로 박혀
# 있고 그래야 맞습니다** — 브라우저에 공개되는 값이고, 격리는 RLS 정책이 합니다.
# 아래 둘은 시험 스크립트가 Node에서 REST를 부를 때만 씁니다.
# 쓰는 곳: scripts/test-rls.mjs · scripts/test-journal-rls.mjs
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 격리 시험용 계정 둘. **한 계정만으로는 격리가 증명되지 않습니다.**
# 비밀번호가 들어가는 자리이므로 이 파일에는 절대 값을 적지 마세요.
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=

# ── 튜닝값 (키 아님, 보통 비워 둡니다) ──────────────────────────────────────

# OECD SDMX 호출 간격·재시도 기준. scripts/lib/oecd.mjs가 자체 기본값을 가집니다.
OECD_MIN_GAP_MS=
OECD_RETRY_BASE_MS=

# ALFRED 호출 최소 간격(초). 기본 0.6.
ALFRED_MIN_GAP_SECONDS=

# python 실행 파일 경로. build-tickers.mjs가 zip·xls 파싱에 python을 부릅니다.
# 비워 두면 PATH의 python을 씁니다.
PYTHON=
