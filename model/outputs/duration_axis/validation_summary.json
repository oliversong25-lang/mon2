  "prespecified_rule": {
    "question": "업종이 잘못된 축이어서 국면이 3%밖에 조직하지 못한 것인가. 듀레이션으로 자르면 달라지는가.",
    "mechanism": "성장주는 현금흐름이 길어 할인율 상승과 성장 기대 하락에 불균형하게 반응한다. 이익 효과가 아니라 밸류에이션 효과다. FF12는 각 통에 듀레이션을 섞으므로 찾으려는 효과를 흐린다.",
    "prior_is_unfavourable": "듀레이션과 가치는 같은 정렬을 반대 방향으로 읽은 것이고, 가치 대 성장의 타이밍은 금융에서 가장 많이 연구됐고 가장 일관되게 실패한 전략에 든다. 여기서의 주장은 더 좁고 기계적이지만 넓은 문헌은 강한 반대 사전 확률이다. 트랙 20이 이 정렬들에 무조건부 프리미엄이 없다는 것도 이미 찾았다 — 다만 평균 0은 강한 조건부 차이와 양립하므로 이 검정을 막지는 않는다.",
    "primary_proxy": "dividend_yield",
    "proxies": [
      "dividend_yield",
      "earnings_to_price",
      "cashflow_to_price",
      "book_to_market"
    ],
    "primary_buckets": "zero group + deciles",
    "secondary_buckets": "zero group + quintiles",
    "comparison_axis": "Fama-French 12 industries, recomputed monthly",
    "top_k": 3,
    "why_the_same_ruler": "정렬 자료가 월간뿐이므로 업종 축도 월간으로 다시 계산한다. 통 수도 맞춰 무배당군+10분위 11통을 기본으로 쓴다 — 통이 적으면 천장이 기계적으로 낮아져 듀레이션 축이 불리해지고, 그것은 이 검정에서 잘못된 방향이다.",
    "stage_one_ceiling": {
      "must_exceed_industry_by": 1.5,
      "floor_annual": 0.08,
      "floor_information_ratio": 1.0,
      "gates_everything_below": true,
      "closes_the_line_if_it_fails": true
    },
    "stage_two_control": {
      "lookbacks": [
        4,
        13,
        26
      ],
      "selection": "highest control-only R-squared, chosen by rule not by result",
      "keeps_the_term_spread": true,
      "horizon_months": 3,
      "null_p_threshold": 0.05,
      "why_these_controls": "제안된 것이 금리 메커니즘이므로 대조도 금리와 변동성이어야 한다. 듀레이션 반응이 금리·변동성 변화만으로 설명되면 그것이 결론이고, 트랙 19·24·25가 각자의 축에서 찾은 것을 되풀이하는 셈이다."
    },
    "stage_three_robustness": {
      "both_exclusion_strengths_must_hold": true,
      "episode_exclusions": [
        "ex_2022",
        "ex_covid",
        "ex_gfc"
      ],
      "why_2022": "2022년이 이 트랙의 명백한 단일 에피소드 의존 후보다. 트랙 17은 2020년을 빼자 무너졌고 트랙 25는 GFC 없이 효과의 3분의 2를 잃었다."
    },
    "multiplicity": {
      "track20_proxies": 4,
      "this_track_proxies": 4,
      "project_wide_family": 8,
      "bonferroni_alpha": 0.00625,
      "fdr_alpha": 0.05
    },
    "what_counts_as_failure": "천장이 같은 자로 잰 업종 축의 1.5배에 못 미치거나 절대 문턱을 넘지 못하면, **순환매 질문은 어떤 축으로 잘라도 닫히고 이 계열은 끝난다.** 업종이 잘못된 축이어서 3%였던 것이 아니라는 뜻이기 때문이다."
